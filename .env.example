# ===========================================
# PSYCHOTEST+ - VARIABLES D'ENVIRONNEMENT
# ===========================================
# Copiez ce fichier vers '.env' et renseignez vos vraies clés API
# ATTENTION: Ne commitez jamais le fichier .env avec vos vraies clés!

# ===========================================
# ENVIRONNEMENT
# ===========================================
# Environnement actuel: development, staging, production
ENVIRONMENT=development

# Version de l'application
APP_VERSION=1.0.0

# ===========================================
# MTN MOBILE MONEY API
# ===========================================
# Clés API MTN Mobile Money
# Obtenir sur: https://momodeveloper.mtn.com/
MTN_SUBSCRIPTION_KEY=your_mtn_subscription_key_here
MTN_API_USER=your_mtn_api_user_uuid_here
MTN_API_KEY=your_mtn_api_key_here

# Configuration MTN Sandbox (pour les tests)
# Ces valeurs sont utilisées en mode développement
MTN_SANDBOX_USER_ID=bcf55fdc-2d80-4c93-b653-74e6bb2c9c3f
MTN_SANDBOX_API_KEY=b0431db58a9b41faa8f5860230aca9ca

# ===========================================
# MOOV MONEY API
# ===========================================
# Clés API Moov Money
# Obtenir sur: https://developer.moov-africa.com/
MOOV_CLIENT_ID=your_moov_client_id_here
MOOV_CLIENT_SECRET=your_moov_client_secret_here
MOOV_API_KEY=your_moov_api_key_here

# Configuration Moov Sandbox
MOOV_SANDBOX_CLIENT_ID=sandbox_client_id
MOOV_SANDBOX_CLIENT_SECRET=sandbox_client_secret

# ===========================================
# ORANGE MONEY API (OPTIONNEL)
# ===========================================
# Clés API Orange Money (si vous souhaitez l'ajouter)
# ORANGE_CLIENT_ID=your_orange_client_id_here
# ORANGE_CLIENT_SECRET=your_orange_client_secret_here
# ORANGE_API_KEY=your_orange_api_key_here

# ===========================================
# FIREBASE CONFIGURATION
# ===========================================
# Configuration Firebase pour Android
FIREBASE_ANDROID_API_KEY=your_firebase_android_api_key_here
FIREBASE_ANDROID_APP_ID=1:123456789:android:abcdef123456
FIREBASE_MESSAGING_SENDER_ID=123456789
FIREBASE_PROJECT_ID=psychotest-plus

# Configuration Firebase pour iOS
FIREBASE_IOS_API_KEY=your_firebase_ios_api_key_here
FIREBASE_IOS_APP_ID=1:123456789:ios:abcdef123456
FIREBASE_IOS_CLIENT_ID=123456789-abcdef123456.apps.googleusercontent.com

# Configuration Firebase pour Web
FIREBASE_WEB_API_KEY=your_firebase_web_api_key_here

# Firebase Cloud Messaging
FCM_SERVER_KEY=your_fcm_server_key_here

# ===========================================
# BACKEND API (SI VOUS EN CRÉEZ UN)
# ===========================================
# URL de votre API backend personnalisée
API_BASE_URL_DEV=https://api-dev.psychotest-plus.com/v1
API_BASE_URL_STAGING=https://api-staging.psychotest-plus.com/v1
API_BASE_URL_PROD=https://api.psychotest-plus.com/v1

# Clé API pour votre backend
API_SECRET_KEY=your_api_secret_key_32_characters_here

# ===========================================
# SÉCURITÉ ET CHIFFREMENT
# ===========================================
# Clé secrète pour signer les webhooks (32 caractères minimum)
WEBHOOK_SECRET=your_webhook_secret_key_change_in_production_32_chars

# Clé de chiffrement pour les données sensibles (32 caractères exactement)
ENCRYPTION_KEY=your_32_character_encryption_key_here

# Salt pour le hashage des mots de passe (si authentification)
PASSWORD_SALT=your_password_salt_here_16_chars_min

# JWT Secret (si vous utilisez JWT pour l'authentification)
JWT_SECRET=your_jwt_secret_key_here_32_characters_minimum

# ===========================================
# ANALYTICS ET MONITORING
# ===========================================
# Google Analytics
GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Sentry pour le monitoring des erreurs (optionnel)
SENTRY_DSN=https://your-sentry-dsn-here@sentry.io/project-id

# Mixpanel pour l'analytics (optionnel)
MIXPANEL_TOKEN=your_mixpanel_token_here

# ===========================================
# BASE DE DONNÉES (SI BACKEND)
# ===========================================
# Configuration MySQL/PostgreSQL (si vous créez un backend)
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=psychotest_plus
# DB_USERNAME=your_db_username
# DB_PASSWORD=your_db_password

# MongoDB (alternative)
# MONGODB_URI=mongodb://username:password@localhost:27017/psychotest_plus

# ===========================================
# EMAIL ET NOTIFICATIONS
# ===========================================
# Configuration SMTP pour l'envoi d'emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here

# SendGrid (alternative pour les emails)
# SENDGRID_API_KEY=your_sendgrid_api_key_here

# Twilio pour les SMS (optionnel)
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=+1234567890

# ===========================================
# STOCKAGE CLOUD (OPTIONNEL)
# ===========================================
# AWS S3 pour le stockage de fichiers
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_BUCKET_NAME=psychotest-plus-storage
# AWS_REGION=us-east-1

# Cloudinary pour les images
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# ===========================================
# CONFIGURATION DE DÉVELOPPEMENT
# ===========================================
# Activation des logs détaillés en développement
DEBUG_MODE=true
LOG_LEVEL=debug

# Simuler les paiements en mode développement
SIMULATE_PAYMENTS=true

# Délai de simulation des paiements (en secondes)
PAYMENT_SIMULATION_DELAY=3

# ===========================================
# RATE LIMITING
# ===========================================
# Nombre maximum de tentatives de paiement par minute
MAX_PAYMENT_ATTEMPTS_PER_MINUTE=5

# Nombre maximum de requêtes API par minute
MAX_API_REQUESTS_PER_MINUTE=60

# ===========================================
# WEBHOOKS ET CALLBACKS
# ===========================================
# URL de base pour les callbacks de paiement
WEBHOOK_BASE_URL=https://your-domain.com/webhooks

# URLs spécifiques pour chaque fournisseur
MTN_CALLBACK_URL=${WEBHOOK_BASE_URL}/mtn/callback
MOOV_CALLBACK_URL=${WEBHOOK_BASE_URL}/moov/callback

# ===========================================
# CONFIGURATION LOCALE
# ===========================================
# Devise par défaut
DEFAULT_CURRENCY=XOF

# Langue par défaut
DEFAULT_LANGUAGE=fr

# Fuseau horaire
DEFAULT_TIMEZONE=Africa/Porto-Novo

# Code pays
COUNTRY_CODE=BJ

# ===========================================
# INSTRUCTIONS POUR OBTENIR LES CLÉS API
# ===========================================

# MTN MOBILE MONEY:
# 1. Créer un compte sur: https://momodeveloper.mtn.com/
# 2. Créer une application
# 3. Obtenir: Subscription Key, API User, API Key
# 4. Tester en mode sandbox avant la production

# MOOV MONEY:
# 1. Contacter Moov Bénin pour l'accès à l'API
# 2. Remplir le formulaire d'intégration partenaire
# 3. Obtenir: Client ID, Client Secret, API Key
# 4. Documentation: developer.moov-africa.com

# FIREBASE:
# 1. Créer un projet sur: https://console.firebase.google.com/
# 2. Ajouter une app Android/iOS
# 3. Télécharger google-services.json (Android) et GoogleService-Info.plist (iOS)
# 4. Copier les clés depuis les fichiers de configuration

# ===========================================
# SÉCURITÉ - IMPORTANT!
# ===========================================
# 1. Ne JAMAIS committer le fichier .env dans Git
# 2. Ajouter .env dans .gitignore
# 3. Utiliser des clés différentes pour développement et production
# 4. Changer toutes les clés par défaut
# 5. Utiliser des mots de passe forts (32+ caractères)
# 6. Rotationner les clés régulièrement en production
# 7. Restreindre l'accès aux clés API par IP si possible

# ===========================================
# EXEMPLE DE COMMANDES POUR GÉNÉRER DES CLÉS
# ===========================================
# Générer une clé de 32 caractères:
# openssl rand -hex 16

# Générer une clé de 64 caractères:
# openssl rand -hex 32

# Générer un UUID:
# uuidgen
